{
  "name": "hiitbuddy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Framework-free HIIT circuit training companion.",
  "scripts": {
    "audit:layout": "npm run build && node scripts/layout-audit.mjs",
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "dev": "npm run build && node scripts/serve.mjs",
    "release": "node .github/scripts/publish-release.mjs",
    "release:plan": "node .github/scripts/release-plan.mjs",
    "start": "node scripts/serve.mjs",
    "test": "npm run build && node --test"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.11",
    "@semantic-release/release-notes-generator": "14.1.1",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "playwright": "^1.61.1",
    "semantic-release": "25.0.9",
    "typescript": "^7.0.0"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.10.0 <27"
  }
}
