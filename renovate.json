{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Berlin",
  "labels": [
    "dependencies"
  ],
  "dependencyDashboard": true,
  "prConcurrentLimit": 5,
  "rangeStrategy": "replace",
  "rebaseWhen": "behind-base-branch",
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 4am on monday"
    ]
  },
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "semanticCommits": "disabled",
  "commitMessagePrefix": "chore: ",
  "packageRules": [
    {
      "description": "Keep major npm updates separate for easier review.",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "npm major dependencies"
    },
    {
      "description": "Batch minor and patch npm updates into one PR.",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "npm minor and patch dependencies"
    },
    {
      "description": "Keep GitHub Action major updates separate.",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "github actions major updates"
    },
    {
      "description": "Batch non-major GitHub Action updates.",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "github actions non-major updates"
    },
    {
      "description": "Update the semantic-release toolchain together, including major versions.",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "semantic-release",
        "@semantic-release/**",
        "conventional-changelog-conventionalcommits"
      ],
      "groupName": "semantic-release toolchain",
      "groupSlug": "semantic-release-toolchain",
      "separateMajorMinor": false
    },
    {
      "description": "The v10 preset requires changelog-writer v9, which the current semantic-release plugins do not support yet.",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "conventional-changelog-conventionalcommits"
      ],
      "allowedVersions": "<10"
    }
  ]
}
